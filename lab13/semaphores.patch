+++ b/kernel/sem.c
@@ -75,3 +75,24 @@ sys_sem_up(void)
   release(&s->lock);
   return 0;
 }
+
+// sem_trydown(id) (optional, number 27): like sem_down, but never sleeps.
+// Returns 0 if it took one unit, -1 at once if the value is 0 (or id is bad).
+uint64
+sys_sem_trydown(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  if (s->value == 0) {
+    release(&s->lock);
+    return -1;
+  }
+  s->value--;
+  release(&s->lock);
+  return 0;
+}
