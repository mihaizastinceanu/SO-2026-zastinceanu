From d80c4e0674649e467a9971111c4aa1fd1b4ecee3 Mon Sep 17 00:00:00 2001
From: Zastinceanu Mihai <zasmih05@gmail.com>
Date: Mon, 2 Nov 2026 16:21:46 +0200
Subject: [PATCH 3/3] Lab 10 optional: sysinfo system call (free memory,
 processes in use)

---
 Makefile         |  1 +
 kernel/defs.h    |  2 ++
 kernel/kalloc.c  | 14 ++++++++++++++
 kernel/proc.c    | 16 ++++++++++++++++
 kernel/syscall.c |  4 +++-
 kernel/syscall.h |  1 +
 kernel/sysinfo.h |  4 ++++
 kernel/sysproc.c | 15 +++++++++++++++
 user/sysinfo.c   | 18 ++++++++++++++++++
 user/user.h      |  2 ++
 user/usys.pl     |  1 +
 11 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 kernel/sysinfo.h
 create mode 100644 user/sysinfo.c

diff --git a/Makefile b/Makefile
index ed785bf..57aecaa 100644
--- a/Makefile
+++ b/Makefile
@@ -147,6 +147,7 @@ UPROGS=\
 	$U/_wc\
 	$U/_zombie\
 	$U/_trace\
+	$U/_sysinfo\
 	$U/_logstress\
 	$U/_forphan\
 	$U/_dorphan\
diff --git a/kernel/defs.h b/kernel/defs.h
index 0ae6896..6c66c4e 100644
--- a/kernel/defs.h
+++ b/kernel/defs.h
@@ -60,6 +60,7 @@ void            ireclaim(int);
 void*           kalloc(void);
 void            kfree(void *);
 void            kinit(void);
+uint64          kfreemem(void);
 
 // log.c
 void            initlog(int, struct superblock*);
@@ -103,6 +104,7 @@ void            yield(void);
 int             either_copyout(int user_dst, uint64 dst, void *src, uint64 len);
 int             either_copyin(void *dst, int user_src, uint64 src, uint64 len);
 void            procdump(void);
+uint64          nproc_used(void);
 
 // swtch.S
 void            swtch(struct context*, struct context*);
diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 2fcec38..2b5c7bc 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -80,3 +80,17 @@ kalloc(void)
     memset((char *)r, 5, PGSIZE); // fill with junk
   return (void *)r;
 }
+
+// Count the free pages on the free list, in bytes.
+uint64
+kfreemem(void)
+{
+  struct run *r;
+  uint64 n = 0;
+
+  acquire(&kmem.lock);
+  for (r = kmem.freelist; r; r = r->next)
+    n += PGSIZE;
+  release(&kmem.lock);
+  return n;
+}
diff --git a/kernel/proc.c b/kernel/proc.c
index b938cfd..1997e10 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -702,3 +702,19 @@ procdump(void)
     printk("\n");
   }
 }
+
+// Count the processes whose state is not UNUSED.
+uint64
+nproc_used(void)
+{
+  struct proc *p;
+  uint64 n = 0;
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      n++;
+    release(&p->lock);
+  }
+  return n;
+}
diff --git a/kernel/syscall.c b/kernel/syscall.c
index 4991849..82768bb 100644
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -104,6 +104,7 @@ extern uint64 sys_mkdir(void);
 extern uint64 sys_close(void);
 extern uint64 sys_sync(void);
 extern uint64 sys_trace(void);
+extern uint64 sys_sysinfo(void);
 
 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -132,6 +133,7 @@ static uint64 (*syscalls[])(void) = {
   [SYS_close]   = sys_close,
   [SYS_sync]    = sys_sync,
   [SYS_trace]   = sys_trace,
+  [SYS_sysinfo] = sys_sysinfo,
   // clang-format on
 };
 
@@ -144,7 +146,7 @@ static char *syscallnames[] = {
   [SYS_pause] "pause", [SYS_uptime] "uptime", [SYS_open] "open",
   [SYS_write] "write", [SYS_mknod] "mknod",   [SYS_unlink] "unlink",
   [SYS_link] "link",   [SYS_mkdir] "mkdir",   [SYS_close] "close",
-  [SYS_sync] "sync",   [SYS_trace] "trace",
+  [SYS_sync] "sync",   [SYS_trace] "trace",   [SYS_sysinfo] "sysinfo",
 };
 
 void
diff --git a/kernel/syscall.h b/kernel/syscall.h
index f66fb28..3b769fd 100644
--- a/kernel/syscall.h
+++ b/kernel/syscall.h
@@ -22,3 +22,4 @@
 #define SYS_close  21
 #define SYS_sync   22
 #define SYS_trace  23
+#define SYS_sysinfo 24
diff --git a/kernel/sysinfo.h b/kernel/sysinfo.h
new file mode 100644
index 0000000..2622261
--- /dev/null
+++ b/kernel/sysinfo.h
@@ -0,0 +1,4 @@
+struct sysinfo {
+  uint64 freemem;   // amount of free memory (bytes)
+  uint64 nproc;     // number of processes in use
+};
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index f3b5d40..c286776 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -6,6 +6,7 @@
 #include "spinlock.h"
 #include "proc.h"
 #include "vm.h"
+#include "sysinfo.h"
 
 uint64
 sys_exit(void)
@@ -119,3 +120,17 @@ sys_trace(void)
   myproc()->trace_mask = mask;
   return 0;
 }
+
+uint64
+sys_sysinfo(void)
+{
+  uint64 addr;
+  struct sysinfo info;
+
+  argaddr(0, &addr);
+  info.freemem = kfreemem();
+  info.nproc = nproc_used();
+  if (either_copyout(1, addr, &info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100644
index 0000000..574975f
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,18 @@
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+// sysinfo: print the free memory and the number of processes in use
+int
+main(int argc, char *argv[])
+{
+  struct sysinfo info;
+
+  if (sysinfo(&info) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+  printf("free memory: %lu bytes (%lu pages)\n", info.freemem, info.freemem / 4096);
+  printf("processes in use: %lu\n", info.nproc);
+  exit(0);
+}
diff --git a/user/user.h b/user/user.h
index b8002ab..4b02e56 100644
--- a/user/user.h
+++ b/user/user.h
@@ -1,6 +1,7 @@
 #define SBRK_ERROR ((char *)-1)
 
 struct stat;
+struct sysinfo;
 
 // system calls
 int fork(void);
@@ -26,6 +27,7 @@ int pause(int);
 int uptime(void);
 int sync(void);
 int trace(int);
+int sysinfo(struct sysinfo *);
 
 // ulib.c
 int stat(const char *, struct stat *);
diff --git a/user/usys.pl b/user/usys.pl
index f9185b5..a49625b 100755
--- a/user/usys.pl
+++ b/user/usys.pl
@@ -44,3 +44,4 @@ entry("pause");
 entry("uptime");
 entry("sync");
 entry("trace");
+entry("sysinfo");
-- 
