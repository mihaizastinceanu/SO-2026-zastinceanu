From 3be1329e94c2fb8f8fed9621865bf0a20c41c608 Mon Sep 17 00:00:00 2001
From: Zastinceanu Mihai <zasmih05@gmail.com>
Date: Mon, 2 Nov 2026 16:21:46 +0200
Subject: [PATCH 2/3] Lab 10: trace system call, kernel side (handler, table,
 names, fork)

---
 kernel/proc.c    |  1 +
 kernel/proc.h    |  1 +
 kernel/syscall.c | 17 +++++++++++++++++
 kernel/sysproc.c |  9 +++++++++
 4 files changed, 28 insertions(+)

diff --git a/kernel/proc.c b/kernel/proc.c
index 31f23a3..b938cfd 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -288,6 +288,7 @@ kfork(void)
   np->cwd = idup(p->cwd);
 
   safestrcpy(np->name, p->name, sizeof(p->name));
+  np->trace_mask = p->trace_mask;
 
   pid = np->pid;
 
diff --git a/kernel/proc.h b/kernel/proc.h
index 5603697..d7f68a6 100644
--- a/kernel/proc.h
+++ b/kernel/proc.h
@@ -101,4 +101,5 @@ struct proc {
   struct file *ofile[NOFILE];  // Open files
   struct inode *cwd;           // Current directory
   char name[16];               // Process name (debugging)
+  int trace_mask;              // which system calls to print
 };
diff --git a/kernel/syscall.c b/kernel/syscall.c
index 1800f20..4991849 100644
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -103,6 +103,7 @@ extern uint64 sys_link(void);
 extern uint64 sys_mkdir(void);
 extern uint64 sys_close(void);
 extern uint64 sys_sync(void);
+extern uint64 sys_trace(void);
 
 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -130,9 +131,22 @@ static uint64 (*syscalls[])(void) = {
   [SYS_mkdir]   = sys_mkdir,
   [SYS_close]   = sys_close,
   [SYS_sync]    = sys_sync,
+  [SYS_trace]   = sys_trace,
   // clang-format on
 };
 
+// the names of the system calls, for trace
+static char *syscallnames[] = {
+  [SYS_fork] "fork",   [SYS_exit] "exit",     [SYS_wait] "wait",
+  [SYS_pipe] "pipe",   [SYS_read] "read",     [SYS_kill] "kill",
+  [SYS_exec] "exec",   [SYS_fstat] "fstat",   [SYS_chdir] "chdir",
+  [SYS_dup] "dup",     [SYS_getpid] "getpid", [SYS_sbrk] "sbrk",
+  [SYS_pause] "pause", [SYS_uptime] "uptime", [SYS_open] "open",
+  [SYS_write] "write", [SYS_mknod] "mknod",   [SYS_unlink] "unlink",
+  [SYS_link] "link",   [SYS_mkdir] "mkdir",   [SYS_close] "close",
+  [SYS_sync] "sync",   [SYS_trace] "trace",
+};
+
 void
 syscall(void)
 {
@@ -144,6 +158,9 @@ syscall(void)
     // Use num to lookup the system call function for num, call it,
     // and store its return value in p->trapframe->a0
     p->trapframe->a0 = syscalls[num]();
+    if((p->trace_mask >> num) & 1)
+      printk("%d: syscall %s -> %ld\n",
+             p->pid, syscallnames[num], p->trapframe->a0);
   } else {
     printk("%d %s: unknown sys call %d\n", p->pid, p->name, num);
     p->trapframe->a0 = -1;
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..f3b5d40 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,12 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_trace(void)
+{
+  int mask;
+  argint(0, &mask);
+  myproc()->trace_mask = mask;
+  return 0;
+}
-- 
